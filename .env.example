# --- PostgreSQL (docker compose db 服务) ---
POSTGRES_DB=pasay_pm
POSTGRES_USER=pasay_pm
POSTGRES_PASSWORD=change-me-strong-password

# --- API 应用 ---
# 本地测试/脚本用 localhost；docker compose 内会被覆盖为 @db:5432
DATABASE_URL=postgresql+psycopg2://pasay_pm:change-me-strong-password@localhost:5432/pasay_pm
UPLOAD_DIR=uploads
# V1.2: bot token for the notifier worker (Telegram sendMessage). Leave empty
# to run the scheduler without sending notifications.
TELEGRAM_BOT_TOKEN=
# V1.2: fallback assignee (backend user id) for business-source tasks with no
# explicit owner, so proactive notifications always have a valid recipient.
# MUST point at an ACTIVE admin/manager user that has a registered Telegram chat id —
# the scheduler worker and bin/run-backfill.py validate this and fail fast if invalid.
# Never leave it unset or pointing at a non-existent/agent/inactive user.
# OPERATIONS_DEFAULT_ASSIGNEE=1
# Designated Secretary/Operator (human) identity for C2 "安排秘书跟进" followup
# fallback when no unique active agent candidate exists. Distinct from the AI
# agent (Lily/Hermes) and from legacy identities. Default 14 (pasay_bot_manager).
# OPERATIONS_SECRETARY_ASSIGNEE=14

# --- 备份到 NAS (scripts/backup.sh) ---
# BACKUP_REMOTE=root@192.168.50.27:/volume1/backup/pasay-pm/
# BACKUP_KEEP=30
# SSH_KEY=~/.ssh/pmp_pasay_backup
# 本地暂存备份文件的目录
# BACKUP_DIR=backups

# --- V1.2.2 Phase C2 copilot execution (kill-switch) ---
# Off by default (fail closed). Set to true ONLY after the C2 tests pass to
# authorize human-confirmed copilot execution (create_followup_task /
# assign_task / snooze_task). NEVER enables financial actions — the executor
# is structurally incapable of touching financial state.
COPILOT_EXECUTION_ENABLED=false

# --- V1.2.2 C1 read-only copilot (LLM provider abstraction) ---
# Secrets only from the environment, never committed. Default provider + per-
# provider overrides (env-var name is the provider uppercased with '-' -> '_').
# COPILOT_LLM_PROVIDER=deepseek
# COPILOT_LLM_API_KEY=  (falls back to DEEPSEEK_API_KEY)
# DEEPSEEK_API_KEY=  (legacy fallback key for the copilot)
# COPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
# COPILOT_LLM_MODEL=deepseek-v4-flash
# COPILOT_LLM_TIMEOUT=120
# COPILOT_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
# COPILOT_LLM_DEEPSEEK_PRO_MODEL=deepseek-v4-pro
