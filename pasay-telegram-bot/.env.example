# --- pasay-telegram-bot ---
# Production bot token (the ONLY consumer after cutover; never commit the real value).
PASSAY_TG_BOT_TOKEN=
PASSAY_API_BASE=http://127.0.0.1:8000/api/v1
# Manager-level key for write operations; admin key only used for OWNER reverse ops.
PASSAY_API_KEY=
PASSAY_ADMIN_API_KEY=
# Hermes NLU adapter (Phase 3+; unused by this phase's deterministic UI).
HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=
HOOK_TOKEN=
# Local SQLite conversation/idempotency state.
STATE_DB=/opt/pasay-pm/pasay-telegram-bot/state/bot_state.db
# How long a confirmation card stays valid (seconds).
CALLBACK_TTL_SECONDS=900
