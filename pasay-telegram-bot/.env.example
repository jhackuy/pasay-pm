# --- pasay-telegram-bot ---
# Production bot token (the ONLY consumer after cutover; never commit the real value).
PASSAY_TG_BOT_TOKEN=
PASSAY_API_BASE=http://127.0.0.1:8000/api/v1
# Manager-level key for write operations; admin key only used for OWNER reverse ops.
PASSAY_API_KEY=
PASSAY_ADMIN_API_KEY=
# Hermes NLU adapter (Phase 3+; unused by this phase's deterministic UI).
HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=
HOOK_TOKEN=
# Local SQLite conversation/idempotency state.
STATE_DB=/opt/pasay-pm/pasay-telegram-bot/state/bot_state.db
# How long a confirmation card stays valid (seconds).
CALLBACK_TTL_SECONDS=900
# HTTP timeout for the backend API client (seconds).
PASSAY_HTTP_TIMEOUT_SECONDS=30
# AI-OPS-FOUNDATION-001: private Telegram archive channel id used as the
# FREE-FIRST media storage layer (photos/documents are forwarded there and
# indexed in the backend `evidence` table). Empty disables forwarding.
PASSAY_ARCHIVE_CHAT_ID=
# JOB-SERVICE-AUTH-002: dedicated SYSTEM credential for the background
# proactive jobs (v2_daily_digest / v2_next_check). The backend resolves it as
# the scheduler SYSTEM principal on the read-only operations endpoints — the
# jobs NEVER bind a HUMAN Owner's Telegram id. Empty disables the jobs (fail
# closed, no Owner fallback). Provisioned by the V1.3 trusted-identity
# migration (purpose internal:scheduler).
PASSAY_JOB_API_KEY=
